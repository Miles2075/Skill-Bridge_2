# Supabase project (Auth)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Neon PostgreSQL (server-only; use the pooled connection string in Vercel)
# DATABASE_URL is preferred. The backend also accepts DATABASE_POSTGRES_URL,
# DATABASE_POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED, POSTGRES_URL,
# or POSTGRES_URL_NON_POOLING when DATABASE_URL is not set.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Vercel Blob (server-only). Connected stores may name this SKILLBRIDGE_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Optional integrations
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# Password-reset email delivery for the built-in LMS/Neon authentication flow.
# Create an API key at https://resend.com and verify the sender domain first.
RESEND_API_KEY=
EMAIL_FROM=Skillbridge <no-reply@your-verified-domain.com>

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
