# ==============================================================================
# SkillBridge Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local (or .env) for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Required in Preview & Production, Optional in Dev)
# ------------------------------------------------------------------------------
# Neon PostgreSQL connection string. In Vercel, use the pooled connection string.
# Fallback aliases accepted by the backend: DATABASE_POSTGRES_URL,
# DATABASE_POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED, POSTGRES_URL, POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ------------------------------------------------------------------------------
# 2. Vercel Blob Video & Media Storage (Required for Hosted Video Uploads)
# ------------------------------------------------------------------------------
# Read/write token generated by Vercel Blob storage.
# Also accepts SKILLBRIDGE_READ_WRITE_TOKEN if named after the Vercel store.
BLOB_READ_WRITE_TOKEN=

# ------------------------------------------------------------------------------
# 3. Authentication (Optional - Built-in Neon LMS Auth works when unset)
# ------------------------------------------------------------------------------
# Supabase project URL and anon/public key (if using Supabase Auth alongside Neon).
# If unset, the app uses built-in Neon-backed LMS authentication.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay API credentials for student course purchases.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# ------------------------------------------------------------------------------
# 5. Email Notifications & Password Reset (Optional)
# ------------------------------------------------------------------------------
# Option A: SMTP Server (e.g. Gmail App Password, AWS SES, SendGrid SMTP)
# NOTE: Ensure SMTP_PORT is not misspelled (e.g., avoid SMTO_PORT in Vercel settings).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Skillbridge <your-email@gmail.com>

# Option B: Resend API
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ------------------------------------------------------------------------------
# 6. General / Application URL
# ------------------------------------------------------------------------------
APP_URL=http://localhost:3000
GEMINI_API_KEY=
