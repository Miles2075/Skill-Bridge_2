# Supabase project (Auth)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Neon PostgreSQL (server-only; use the pooled connection string in Vercel)
# DATABASE_URL is preferred. The backend also accepts DATABASE_POSTGRES_URL,
# DATABASE_POSTGRES_URL_NON_POOLING, DATABASE_URL_UNPOOLED, POSTGRES_URL,
# or POSTGRES_URL_NON_POOLING when DATABASE_URL is not set.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Vercel Blob (server-only). Connected stores may name this SKILLBRIDGE_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=

# Optional integrations
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# Password-reset email delivery for the built-in LMS/Neon authentication flow.
# Option A: Gmail SMTP (no custom domain required). Enable Google 2-Step Verification
# and create an App Password at https://myaccount.google.com/apppasswords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
# EMAIL_FROM is optional with Gmail SMTP; defaults to "Skillbridge <SMTP_USER>".
# If set, use the same Gmail address in the sender, e.g. "Skillbridge <your-gmail-address@gmail.com>".
EMAIL_FROM=

# Option B: Resend. For sending to other users, verify a domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
VITE_RAZORPAY_KEY_ID=
